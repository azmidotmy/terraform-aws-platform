{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyStateBucketDeletion",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:PutBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::*-tfstate-*"
    },
    {
      "Sid": "DenyStoppingAudit",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail"
      ],
      "Resource": "*"
    }
  ]
}
